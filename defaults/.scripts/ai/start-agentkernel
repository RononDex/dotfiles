#!/usr/bin/env bash
# oc: open OpenCode in this project's agentkernel sandbox (creates it on first run)
set -euo pipefail

name="${1:-$(basename "$PWD")}"
name="${name//[^A-Za-z0-9-]/-}"
cfg="${OC_CONFIG:-$HOME/.config/opencode-ecc.toml}"

if ! agentkernel sandbox info "$name" >/dev/null 2>&1; then
	agentkernel sandbox create "$name" --config "$cfg" -B firecracker \
		--dir "$PWD" --ssh --secret ANTHROPIC_API_KEY:api.anthropic.com
else
	# ponytail: ignores errors so an "already running" sandbox doesn't abort; a real start failure shows up at the ssh step
	agentkernel sandbox start "$name" >/dev/null 2>&1 || true
fi

# A fresh SSH config every run: the sandbox's SSH port can change between restarts
exec ssh -t -F <(agentkernel ssh config "$name") "agentkernel-$name" \
	'export PATH="$HOME/.opencode/bin:$PATH"; cd /workspace && exec opencode'
