#!/usr/bin/env bash
# oc-sandbox.sh: open OpenCode (with ECC + Ponytail) in a microsandbox for $PWD.
# Re-running in the same directory reuses that directory's sandbox.
#
#   oc-sandbox.sh            # create/start + launch opencode
#   oc-sandbox.sh --shell    # create/start + drop into bash instead
#   oc-sandbox.sh --rm       # delete this directory's sandbox
set -euo pipefail

IMAGE="${OC_IMAGE:-node:22-bookworm}"
CPUS="${OC_CPUS:-2}"
MEM="${OC_MEM:-4G}"
ECC_REF="${ECC_REF:-main}"
OC_VERSION="${OC_VERSION:-2.3.2}" # OpenCode 2 (npm: @opencode/cli); "latest" also works
GUEST_DIR="/workspace"

command -v msb >/dev/null || {
	echo "msb not found: curl -fsSL https://install.microsandbox.dev | sh" >&2
	exit 1
}

# Name the sandbox after the directory: readable basename + short hash of the full path.
WORKDIR="$(pwd -P)"
slug="$(basename "$WORKDIR" | tr -c 'a-zA-Z0-9-' '-' | cut -c1-40)"
hash="$(printf '%s' "$WORKDIR" | sha256sum | cut -c1-8)"
NAME="oc-${slug%-}-${hash}"

if [[ "${1:-}" == "--rm" ]]; then
	msb rm --force "$NAME"
	exit 0
fi

exists() { msb ls -q | grep -qxF "$NAME"; }
running() { msb ls --running -q | grep -qxF "$NAME"; }

if ! exists; then
	echo ">> creating sandbox $NAME for $WORKDIR"
	# A named volume for the OpenCode config/data dirs keeps logins and plugins
	# if the sandbox is ever recreated with --replace.
	msb create "$IMAGE" --name "$NAME" -c "$CPUS" -m "$MEM" \
		-v "$WORKDIR:$GUEST_DIR" \
		--mount-named "${NAME}-home:/root/.local/share/opencode" \
		-w "$GUEST_DIR" \
		--label tool=opencode --label "hostdir=$hash"
elif ! running; then
	echo ">> starting existing sandbox $NAME"
	msb start -q "$NAME"
fi

# One-time setup inside the guest. A marker file makes it idempotent.
msb exec -q "$NAME" -- bash -lc "$(
	cat <<EOF
set -euo pipefail
[ -f /root/.oc-provisioned ] && exit 0
echo '>> provisioning (first run only)...'
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq git curl ca-certificates ripgrep >/dev/null

# OpenCode 2 ships as @opencode/cli; the old opencode-ai package is still 1.x
npm install -g "@opencode/cli@$OC_VERSION" >/dev/null

# ECC: build the OpenCode payload and install globally
#git clone --depth 1 -b "$ECC_REF" https://github.com/affaan-m/ECC.git /opt/ECC
#cd /opt/ECC
#npm install --silent && npm run build:opencode
#./install.sh --profile core --target opencode --no-hooks

# Ponytail via 'plugin add'; if that fails, add it to the OpenCode 2 'plugins' key directly
if ! opencode plugin add @dietrichgebert/ponytail 2>/dev/null; then
  mkdir -p /root/.config/opencode
  cfg=/root/.config/opencode/opencode.json
  [ -f "\$cfg" ] || echo '{}' > "\$cfg"
  node -e '
    const fs=require("fs"),f=process.argv[1],c=JSON.parse(fs.readFileSync(f));
    c.plugins=[...new Set([...(c.plugins||[]),"@dietrichgebert/ponytail","ecc-universal"])];
    fs.writeFileSync(f,JSON.stringify(c,null,2));' "\$cfg"
  npm install -g ecc-universal @dietrichgebert/ponytail >/dev/null
fi

touch /root/.oc-provisioned
echo '>> provisioning done'
EOF
)"

# Install CC Safety Net in existing guests too, without repeating base provisioning.
msb exec -q "$NAME" -- bash -lc '
set -euo pipefail
[ -f /root/.oc-default-plugins-installed ] && exit 0
opencode plugin add cc-safety-net@2.8.1
touch /root/.oc-default-plugins-installed
'

# Refresh editable settings on every launch without replacing ECC's global config.
CONFIG_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
for CONFIG_NAME in opencode.json cli.json; do
	CONFIG_CONTENT="$(cat "$CONFIG_DIR/$CONFIG_NAME")"
	CONFIG_TARGET="/etc/opencode/$CONFIG_NAME"
	if [[ "$CONFIG_NAME" == "cli.json" ]]; then
		CONFIG_TARGET="/root/.config/opencode/cli.json"
	fi
	msb exec -q "$NAME" -- node -e '
  const fs = require("fs"), path = require("path");
  const file = process.argv[1], content = process.argv[2];
  const config = JSON.parse(content);
  if (!config || typeof config !== "object" || Array.isArray(config))
    throw new Error("OpenCode config must be a JSON object");
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, content + "\n");
 ' "$CONFIG_TARGET" "$CONFIG_CONTENT"
done

if [[ "${1:-}" == "--shell" ]]; then
	exec msb exec -t -w "$GUEST_DIR" "$NAME" -- bash -l
fi
exec msb exec -t -w "$GUEST_DIR" "$NAME" -- opencode "$@"
