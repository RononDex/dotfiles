[Unit]
Description=Back up Hostpoint to kDrive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=backup-svc
ExecStart=/usr/bin/bash /home/backups-svc/scripts/backup-hotpoint-restic.sh

ProtectSystem=strict
ReadWritePaths=/home/backup-svc/hostpoint-mnt
PrivateTmp=yes
CacheDirectory=restic-hostpoint
CacheDirectoryMode=0700
Environment=RESTIC_CACHE_DIR=/var/cache/restic-hostpoint
